{
  "name": "recon-ai-infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy": "cdk deploy --all --require-approval never",
    "deploy:testing": "cdk deploy --all --require-approval never -c deploymentTier=testing",
    "deploy:optimized": "cdk deploy --all --require-approval never -c deploymentTier=optimized",
    "deploy:premium": "cdk deploy --all --require-approval never -c deploymentTier=premium"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "22.x",
    "aws-cdk": "2.x",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "~5.4.0"
  },
  "dependencies": {
    "@aws-cdk/aws-lambda-python-alpha": "^2.240.0-alpha.0",
    "aws-cdk-lib": "2.x",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  }
}
